POINT 10 mm 0 mm
POINT 11.5 mm 1.8 mm
POINT 10 mm 3.5 mm
POINT 10.8 mm 5.2 mm
POINT 8.8 mm 7 mm
POINT 2.2 mm 7 mm
POINT 0.2 mm 5.2 mm
POINT 1 mm 3.5 mm
POINT -0.5 mm 1.8 mm
END
PROFILE stator_dovetail_neck
POINT 1.5 mm 0.8 mm
POINT 8.5 mm 0.8 mm
POINT 9.5 mm 2.1 mm
POINT 8.7 mm 3.5 mm
POINT 9.2 mm 4.8 mm
POINT 7.8 mm 6.2 mm
POINT 3.2 mm 6.2 mm
POINT 1.8 mm 4.8 mm
POINT 2.3 mm 3.5 mm
POINT 1.5 mm 2.1 mm
END
PROFILE ngv_dovetail_base
POINT 0 mm 0 mm
POINT 10 mm 0 mm
POINT 9 mm 8 mm
POINT 1 mm 8 mm
END
PROFILE ngv_dovetail_neck
POINT 1.5 mm 1 mm
POINT 8.5 mm 1 mm
POINT 8 mm 7 mm
POINT 2 mm 7 mm
END
PROFILE turbine_fir_tree_base
POINT 2 mm 0 mm
POINT 16 mm 0 mm
POINT 18 mm 2 mm
POINT 15 mm 3.5 mm
POINT 17 mm 5.5 mm
POINT 14 mm 7 mm
POINT 13 mm 10 mm
POINT 5 mm 10 mm
POINT 4 mm 7 mm
POINT 1 mm 5.5 mm
POINT 3 mm 3.5 mm
POINT 0 mm 2 mm
END
PROFILE turbine_fir_tree_neck
POINT 4 mm 1 mm
POINT 14 mm 1 mm
POINT 15 mm 2.5 mm
POINT 13 mm 4 mm
POINT 14 mm 5.5 mm
POINT 12 mm 7 mm
POINT 11.5 mm 9 mm
POINT 6.5 mm 9 mm
