END
PROFILE turbine_transition_section
POINT 92 mm 0 mm
POINT 145 mm 0 mm
POINT 164 mm 30 mm
POINT 98 mm 30 mm
END
PROFILE combustor_casing_section
POINT 179 mm 0 mm
POINT 185 mm 0 mm
POINT 185 mm 200 mm
POINT 179 mm 200 mm
END
PROFILE combustor_outer_liner_section
POINT 141 mm 0 mm
POINT 145 mm 0 mm
POINT 145 mm 155 mm
POINT 141 mm 155 mm
END
# Three abutting 51.667 mm rolled sections keep each perforation row in one
# drill/boolean setup and form the complete 155 mm fabricated inner liner.
PROFILE combustor_inner_liner_section
POINT 86 mm 0 mm
POINT 90 mm 0 mm
POINT 90 mm 51.666667 mm
POINT 86 mm 51.666667 mm
END
PROFILE front_flange_section
POINT 174 mm 0 mm
POINT 200 mm 0 mm
POINT 200 mm 10 mm
POINT 174 mm 10 mm
END
PROFILE labyrinth_section
POINT 22 mm 0 mm
POINT 30 mm 0 mm
POINT 30 mm 8 mm
POINT 22 mm 8 mm
END
PROFILE fuel_tube_profile
CIRCLE 0 mm 0 mm 3 mm
END

# 4 mm across-flats internal hex used by the M6 socket-head fasteners.
PROFILE m6_hex_socket
POINT 2.31 mm 0 mm
POINT 1.155 mm 2 mm
POINT -1.155 mm 2 mm
POINT -2.31 mm 0 mm
POINT -1.155 mm -2 mm
POINT 1.155 mm -2 mm
END

# ISO M6 external hex head, 10 mm across flats.
PROFILE m6_hex_head
POINT 5.774 mm 0 mm
POINT 2.887 mm 5 mm
POINT -2.887 mm 5 mm
POINT -5.774 mm 0 mm
POINT -2.887 mm -5 mm
POINT 2.887 mm -5 mm
END

