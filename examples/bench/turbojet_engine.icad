# Single-spool turbojet ground-demonstrator DEVELOPMENT model.
# Current geometry maturity is the preserved R3 packaging benchmark: it is not
# released for rotating-hardware fabrication, fueled operation, flight, or a
# certification claim. Accepted partner evidence controls every future change.
# Design authority: this ICAD source, its adjacent evidence manifest, and
# DESIGN_PREPARATION.md.
REQUIRES ICAD 1.0
REQUIRES CAPABILITY PARAMETER_EXPRESSIONS_V1
REQUIRES CAPABILITY QUALIFIED_VALUE_REFERENCES_V1
REQUIRES CAPABILITY MULTI_SHAPE_SKETCH_V1
REQUIRES CAPABILITY SKETCH_REGION_ARRANGEMENT_V1
REQUIRES CAPABILITY ADVANCED_SKETCH_CONSTRAINTS_V1
REQUIRES CAPABILITY BODY_HISTORY
REQUIRES CAPABILITY NAMED_SKETCH_ENTITIES
REQUIRES CAPABILITY ASSEMBLY_OCCURRENCES
REQUIRES CAPABILITY MATES_AND_JOINTS
REQUIRES CAPABILITY MANUFACTURING_CONNECTIONS_V1
REQUIRES CAPABILITY MATERIAL_PROFILE_V1
REQUIRES CAPABILITY CALCULATED_BILINGUAL_BOM_V1
REQUIRES CAPABILITY MAGNETIC_INTERFACE_SNAP_V1
REQUIRES CAPABILITY SCENES
REQUIRES CAPABILITY VISUAL_JSON_V1
PROJECT single_spool_turbojet
UNITS mm
TOLERANCE LINEAR 0.1 mm ANGULAR 0.25 deg

# Editable system parameters and derived design handles. TGD-REQ-ENV-001 fixes
# the preferred candidate envelope. Running clearances remain Gate-1 open.
PARAMETER engine_length 1000 mm
PARAMETER max_radius 200 mm
PARAMETER shaft_radius 20 mm
PARAMETER shaft_diameter shaft_radius * 2
PARAMETER flange_hole_radius 3.4 mm
PARAMETER bolt_radius 3 mm
PARAMETER casing_wall 6 mm
PARAMETER liner_wall 4 mm
PARAMETER bearing_clearance 0.05 mm
PARAMETER disk_bore_radius shaft_radius + 0.2 mm
PARAMETER rotor_axial_clearance 10 mm
PARAMETER general_gap 0.2 mm
ANGLE home_angle 0 deg

# Principal datums and assembly anchors.
POINT3 world_origin 0 mm 0 mm 0 mm
POINT3 engine_rear 1000 mm 0 mm 0 mm
POINT3 ground_anchor 300 mm 0 mm 0 mm
POINT3 front_flange_joint 10 mm 0 mm 0 mm
POINT3 compressor_front_joint 140 mm 0 mm 0 mm
POINT3 combustor_front_joint 490 mm 0 mm 0 mm
POINT3 turbine_front_joint 700 mm 0 mm 0 mm
POINT3 exhaust_front_joint 835 mm 0 mm 0 mm
POINT3 exit_flange_joint 990 mm 0 mm 0 mm
POINT3 front_bearing_axis 160 mm 20 mm 0 mm
POINT3 rear_bearing_axis 816 mm 20 mm 0 mm
POINT3 shaft_joint_anchor 160 mm 20 mm 0 mm
POINT3 cover_joint 610 mm 0 mm 192 mm
POINT3 mount_front_joint 390 mm 0 mm -180 mm
POINT3 mount_rear_joint 640 mm 0 mm -190 mm
POINT3 shaft_front_edge 80 mm 20 mm 0 mm
POINT3 mount_front_edge 350 mm -90 mm -200 mm
POINT3 service_lug_chamfer_edge 360 mm -100 mm -205 mm
POINT3 service_lug_fillet_edge 610 mm -100 mm -205 mm
POINT3 fuel_path_a 520 mm 158 mm 188 mm
POINT3 fuel_path_b 600 mm 165 mm 198 mm
POINT3 fuel_path_c 680 mm 158 mm 184 mm
POINT3 mirror_y0 0 mm 0 mm 0 mm
POINT3 cover_origin 565 mm -45 mm 192 mm
POINT3 rotor_180_joint 185 mm 20 mm 0 mm
POINT3 rotor_230_joint 235 mm 20 mm 0 mm
POINT3 rotor_280_joint 285 mm 20 mm 0 mm
POINT3 rotor_330_joint 335 mm 20 mm 0 mm
POINT3 rotor_380_joint 385 mm 20 mm 0 mm
POINT3 rotor_430_joint 435 mm 20 mm 0 mm
POINT3 turbine_rotor_joint 764 mm 20 mm 0 mm
VECTOR engine_axis 1 0 0
VECTOR engine_axis_reverse -1 0 0
VECTOR vertical_axis 0 0 1
VECTOR vertical_axis_reverse 0 0 -1
VECTOR lateral_axis 0 1 0

# Manufacturing materials. Colors distinguish modules; geometry carries function.
MATERIAL casing_alloy
PROFILE KAISER_ALUMINUM_6061_T6_T651_SHEET_PLATE
PRESET ALUMINUM
BASE_COLOR 0.42 0.46 0.5 1
METALLIC 0.9
ROUGHNESS 0.25
TEXTURE_SCALE 40 mm
UV_MODE CYLINDRICAL
END
MATERIAL titanium_rotor
PROFILE ATI_TI_6AL_4V_GRADE5_BAR
PRESET TITANIUM
BASE_COLOR 0.62 0.66 0.71 1
METALLIC 0.95
ROUGHNESS 0.16
TEXTURE_SCALE 25 mm
UV_MODE CYLINDRICAL
END
MATERIAL hot_nickel
PROFILE SPECIAL_METALS_INCONEL_718
PRESET CHROME
BASE_COLOR 0.48 0.32 0.2 1
METALLIC 0.96
ROUGHNESS 0.3
TEXTURE_SCALE 22 mm
UV_MODE CYLINDRICAL
END
MATERIAL liner_stainless
PROFILE OUTOKUMPU_PRODEC_316L_4404
PRESET STRUCTURAL_STEEL
BASE_COLOR 0.55 0.46 0.32 1
METALLIC 0.9
ROUGHNESS 0.36
TEXTURE_SCALE 18 mm
UV_MODE CYLINDRICAL
END
MATERIAL bearing_steel
PROFILE OVAKO_100CR6_803D
PRESET CHROME
END
MATERIAL fastener_steel STRUCTURAL_STEEL
MATERIAL bracket_steel
PROFILE SSAB_DOMEX_355MC
PRESET STRUCTURAL_STEEL
END

