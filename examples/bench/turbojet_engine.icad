INTERFACE rotor_fit_211_a BODY compressor_rotor_disk_6 AT rotor_fit_211_datum AXIS engine_axis TYPE PIN SIZE 8 mm
INTERFACE rotor_fit_211_b BODY shaft_continuous AT rotor_fit_211_datum AXIS engine_axis_reverse TYPE HOLE SIZE 8 mm
CONNECT rotor_fit_211 rotor_fit_211_a rotor_fit_211_b METHOD PRESS_FIT STANDARD ISO_286 FIT H7_p6 CLEARANCE 0.1 mm AUTO


# Inlet cone bore retains 0.2 mm diametral shaft assembly clearance.
POINT3 inlet_cone_shaft_fit_datum 100 mm 20.1 mm 0 mm
INTERFACE inlet_cone_shaft_fit_a BODY inlet_cone AT inlet_cone_shaft_fit_datum AXIS engine_axis TYPE HOLE SIZE 40.4 mm
INTERFACE inlet_cone_shaft_fit_b BODY shaft_continuous AT inlet_cone_shaft_fit_datum AXIS engine_axis_reverse TYPE PIN SIZE 40 mm
CONNECT inlet_cone_shaft_fit inlet_cone_shaft_fit_a inlet_cone_shaft_fit_b METHOD SLIP_FIT STANDARD ISO_286 FIT H7_g6 CLEARANCE 0.2 mm AUTO

# Two-sided manufacturing interfaces and seated connection contracts.
INTERFACE front_flange_side BODY inlet_mounting_flange AT front_flange_joint AXIS engine_axis TYPE FLANGE SIZE 300 mm
INTERFACE inlet_casing_side BODY inlet_casing AT front_flange_joint AXIS engine_axis_reverse TYPE FLANGE SIZE 300 mm
INTERFACE inlet_rear_side BODY inlet_casing AT compressor_front_joint AXIS engine_axis TYPE FLANGE SIZE 360 mm
INTERFACE compressor_front_side BODY structure_compressor_front_flange AT compressor_front_joint AXIS engine_axis_reverse TYPE FLANGE SIZE 360 mm
INTERFACE compressor_rear_side BODY structure_compressor_casing AT combustor_front_joint AXIS engine_axis TYPE FLANGE SIZE 360 mm
INTERFACE combustor_front_side BODY structure_combustor_front_flange AT combustor_front_joint AXIS engine_axis_reverse TYPE FLANGE SIZE 360 mm
INTERFACE combustor_rear_side BODY combustor_casing AT turbine_front_joint AXIS engine_axis TYPE FLANGE SIZE 360 mm
INTERFACE turbine_front_side BODY structure_turbine_front_flange AT turbine_front_joint AXIS engine_axis_reverse TYPE FLANGE SIZE 360 mm
INTERFACE turbine_rear_side BODY turbine_casing AT exhaust_front_joint AXIS engine_axis TYPE FLANGE SIZE 340 mm
INTERFACE exhaust_front_side BODY structure_exhaust_front_flange AT exhaust_front_joint AXIS engine_axis_reverse TYPE FLANGE SIZE 340 mm
INTERFACE exhaust_rear_side BODY exhaust_nozzle AT exit_flange_joint AXIS engine_axis TYPE FLANGE SIZE 240 mm
INTERFACE exit_flange_side BODY exhaust_mounting_flange AT exit_flange_joint AXIS engine_axis_reverse TYPE FLANGE SIZE 240 mm
INTERFACE shaft_front_journal BODY shaft_continuous AT front_bearing_axis AXIS engine_axis TYPE SHAFT SIZE 40 mm
INTERFACE front_bearing_bore BODY bearing_front_inner_race AT front_bearing_axis AXIS engine_axis_reverse TYPE BEARING_SEAT SIZE 40 mm
INTERFACE shaft_rear_journal BODY shaft_continuous AT rear_bearing_axis AXIS engine_axis TYPE SHAFT SIZE 40 mm
INTERFACE rear_bearing_bore BODY bearing_rear_inner_race AT rear_bearing_axis AXIS engine_axis_reverse TYPE BEARING_SEAT SIZE 40 mm
INTERFACE inspection_boss_mount BODY structure_inspection_boss AT cover_joint AXIS vertical_axis TYPE MOUNT SIZE 90 mm
INTERFACE inspection_cover_flange BODY structure_inspection_cover AT cover_joint AXIS vertical_axis_reverse TYPE FLANGE SIZE 90 mm
INTERFACE compressor_mount_face BODY structure_compressor_casing AT mount_front_joint AXIS vertical_axis_reverse TYPE MOUNT SIZE 80 mm
INTERFACE front_bracket_face BODY structure_mount_front AT mount_front_joint AXIS vertical_axis TYPE FLANGE SIZE 80 mm
INTERFACE combustor_mount_face BODY structure_combustor_mount_pad AT mount_rear_joint AXIS vertical_axis_reverse TYPE MOUNT SIZE 80 mm
INTERFACE rear_bracket_face BODY structure_mount_rear AT mount_rear_joint AXIS vertical_axis TYPE FLANGE SIZE 80 mm
CONNECT front_mount front_flange_side inlet_casing_side METHOD BOLTED STANDARD ISO_4017 FASTENER M6 QUANTITY 8 CLEARANCE 0.2 mm AUTO
CONNECT compressor_front_mount inlet_rear_side compressor_front_side METHOD BOLTED STANDARD ISO_4017 FASTENER M6 QUANTITY 12 CLEARANCE 0.2 mm AUTO
CONNECT combustor_mount compressor_rear_side combustor_front_side METHOD BOLTED STANDARD ISO_4017 FASTENER M6 QUANTITY 12 CLEARANCE 0.2 mm AUTO
CONNECT turbine_mount combustor_rear_side turbine_front_side METHOD BOLTED STANDARD ISO_4017 FASTENER M6 QUANTITY 12 CLEARANCE 0.2 mm AUTO
CONNECT exhaust_mount turbine_rear_side exhaust_front_side METHOD BOLTED STANDARD ISO_4017 FASTENER M6 QUANTITY 10 CLEARANCE 0.2 mm AUTO
CONNECT exit_mount exhaust_rear_side exit_flange_side METHOD BOLTED STANDARD ISO_4017 FASTENER M6 QUANTITY 8 CLEARANCE 0.2 mm AUTO
CONNECT front_bearing_fit shaft_front_journal front_bearing_bore METHOD BEARING STANDARD ISO_492 FIT H7_g6 CLEARANCE 0.05 mm AUTO
CONNECT rear_bearing_fit shaft_rear_journal rear_bearing_bore METHOD BEARING STANDARD ISO_492 FIT H7_g6 CLEARANCE 0.05 mm AUTO
CONNECT inspection_cover_mount inspection_boss_mount inspection_cover_flange METHOD BOLTED STANDARD ISO_4017 FASTENER M6 QUANTITY 4 CLEARANCE 0.2 mm AUTO
CONNECT front_engine_mount compressor_mount_face front_bracket_face METHOD BOLTED STANDARD ISO_4017 FASTENER M8 QUANTITY 4 CLEARANCE 0.2 mm AUTO
CONNECT rear_engine_mount combustor_mount_face rear_bracket_face METHOD BOLTED STANDARD ISO_4017 FASTENER M8 QUANTITY 4 CLEARANCE 0.2 mm AUTO

# Proper parent-child mechanism graph. Only the continuous shaft has a DOF.
JOINT engine_ground FIXED WORLD structure_compressor_casing AT ground_anchor AXIS engine_axis
JOINT compressor_front_flange_mount FIXED structure_compressor_casing structure_compressor_front_flange AT compressor_front_joint AXIS engine_axis
JOINT inlet_module FIXED structure_compressor_front_flange inlet_casing AT compressor_front_joint AXIS engine_axis
JOINT inlet_front_flange_mount FIXED inlet_casing inlet_mounting_flange AT front_flange_joint AXIS engine_axis
JOINT combustor_front_flange_mount FIXED structure_compressor_casing structure_combustor_front_flange AT combustor_front_joint AXIS engine_axis
JOINT combustor_module FIXED structure_combustor_front_flange combustor_casing AT combustor_front_joint AXIS engine_axis
JOINT turbine_front_flange_mount FIXED combustor_casing structure_turbine_front_flange AT turbine_front_joint AXIS engine_axis
JOINT turbine_module FIXED structure_turbine_front_flange turbine_casing AT turbine_front_joint AXIS engine_axis
JOINT exhaust_front_flange_mount FIXED turbine_casing structure_exhaust_front_flange AT exhaust_front_joint AXIS engine_axis
JOINT exhaust_module FIXED structure_exhaust_front_flange exhaust_nozzle AT exhaust_front_joint AXIS engine_axis
JOINT exit_flange_mount FIXED exhaust_nozzle exhaust_mounting_flange AT exit_flange_joint AXIS engine_axis
JOINT single_spool_rotation REVOLUTE structure_compressor_casing shaft_continuous AT shaft_joint_anchor AXIS engine_axis VALUE home_angle LIMIT -360 deg 360 deg
JOINT compressor_disk_1_retained FIXED shaft_continuous compressor_rotor_disk_1 AT rotor_180_joint AXIS engine_axis
JOINT compressor_disk_2_retained FIXED shaft_continuous compressor_rotor_disk_2 AT rotor_230_joint AXIS engine_axis
JOINT compressor_disk_3_retained FIXED shaft_continuous compressor_rotor_disk_3 AT rotor_280_joint AXIS engine_axis
JOINT compressor_disk_4_retained FIXED shaft_continuous compressor_rotor_disk_4 AT rotor_330_joint AXIS engine_axis
JOINT compressor_disk_5_retained FIXED shaft_continuous compressor_rotor_disk_5 AT rotor_380_joint AXIS engine_axis
JOINT compressor_disk_6_retained FIXED shaft_continuous compressor_rotor_disk_6 AT rotor_430_joint AXIS engine_axis
JOINT turbine_disk_retained FIXED shaft_continuous turbine_rotor_disk AT turbine_rotor_joint AXIS engine_axis
JOINT front_inner_race_retained FIXED shaft_continuous bearing_front_inner_race AT front_bearing_axis AXIS engine_axis
JOINT rear_inner_race_retained FIXED shaft_continuous bearing_rear_inner_race AT rear_bearing_axis AXIS engine_axis
JOINT front_outer_race_seated FIXED structure_compressor_casing bearing_front_outer_race AT front_bearing_axis AXIS engine_axis
JOINT rear_outer_race_seated FIXED turbine_casing bearing_rear_outer_race AT rear_bearing_axis AXIS engine_axis
JOINT inspection_cover_fixed FIXED structure_inspection_boss structure_inspection_cover AT cover_joint AXIS vertical_axis
JOINT front_mount_fixed FIXED structure_compressor_casing structure_mount_front AT mount_front_joint AXIS vertical_axis
JOINT rear_mount_fixed FIXED combustor_casing structure_mount_rear AT mount_rear_joint AXIS vertical_axis

# Inspection animation: stationary casing, one complete spool revolution.
SCENE spool_inspection
DURATION 5 s
FPS 24
BACKGROUND STUDIO
LOOP 1
LIGHT key DIRECTIONAL COLOR 1 0.96 0.9 INTENSITY 1.2
LIGHT fill DIRECTIONAL COLOR 0.55 0.68 1 INTENSITY 0.55
EVENT 0 s inspection_begin
EVENT 5 s inspection_complete
TRACK spool_rotation JOINT single_spool_rotation
EASING LINEAR
KEYFRAME 0 s VALUE 0 deg
KEYFRAME 2.5 s VALUE 180 deg
KEYFRAME 5 s VALUE 360 deg
END
END
