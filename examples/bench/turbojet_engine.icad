# Captured blade-root profiles. Compressor and stator roots use machined
# dovetails; the hotter turbine rotor uses a two-lobe fir-tree section.
PROFILE compressor_dovetail_base
POINT 0 mm 0 mm
POINT 12 mm 0 mm
POINT 14 mm 2 mm
POINT 12.5 mm 4 mm
POINT 13.5 mm 6 mm
POINT 11 mm 8 mm
POINT 3 mm 8 mm
POINT 0.5 mm 6 mm
POINT 1.5 mm 4 mm
POINT 0 mm 2 mm
END
PROFILE compressor_dovetail_neck
POINT 2 mm 1 mm
POINT 10 mm 1 mm
POINT 11.5 mm 2.5 mm
POINT 10.5 mm 4 mm
POINT 11 mm 5.5 mm
POINT 9.5 mm 7 mm
POINT 4 mm 7 mm
POINT 2.5 mm 5.5 mm
POINT 3 mm 4 mm
POINT 2 mm 2.5 mm
END
PROFILE stator_dovetail_base
